# Segredo do JWT - gere um valor forte e nunca use o exemplo em producao
# Exemplo: JWT_SECRET=$(openssl rand -hex 32)
JWT_SECRET=gere_um_segredo_com_openssl_rand_hex_32
# Porta HTTP do servidor
PORT=3000
# PostgreSQL local
DATABASE_URL=postgres://arcadia:troque_esta_senha@127.0.0.1:5432/arcadia
# Banco usado pela suite; nunca aponte para producao
TEST_DATABASE_URL=postgres://arcadia:troque_esta_senha@127.0.0.1:5432/arcadia_test
# Diretorio de arquivos enviados e do SQLite legado usado apenas na migracao.
# Caminho relativo ao working directory do server (use absoluto em systemd).
DATA_DIR=./data
# Limite geral e de credenciais dos endpoints publicos de autenticacao (por IP)
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=60
AUTH_CREDENTIAL_RATE_LIMIT_MAX=30
# Hostname publico do Funnel (apos configurar o Tailscale)
# ARCADIA_PUBLIC_URL=https://seu-host.ts.net
