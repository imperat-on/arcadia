{
  "name": "arcadia",
  "version": "1.0.4",
  "desktopName": "arcadia.desktop",
  "private": true,
  "main": "electron/main.js",
  "build": {
    "appId": "io.github.imperat-on.arcadia",
    "productName": "Arcadia",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/logo-512.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../contracts",
        "to": "contracts"
      },
      {
        "from": "../boot.mp4",
        "to": "boot.mp4"
      }
    ],
    "linux": {
      "executableName": "arcadia",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "icon": "public/logo-512.png",
      "category": "Game",
      "artifactName": "Arcadia-${version}-${arch}.${ext}"
    },
    "appImage": {
      "executableArgs": []
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dist:appimage": "vite build && electron-builder --linux AppImage --x64",
    "test": "NODE_ENV=test node --test",
    "electron": "electron .",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "hls.js": "^1.6.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.3"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}
